{
  "name": "Drive \u2192 Portfolio Auto-Sync",
  "description": "D\u00e9tecte chaque nouveau fichier ajout\u00e9 dans Google Drive et l'int\u00e8gre automatiquement au portfolio avec une description SEO g\u00e9n\u00e9r\u00e9e par IA.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "connector",
      "events": [
        "changes"
      ],
      "integration_type": "googledrive",
      "resource_id": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "drive_portfolio_auto_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "drivePortfolioSync",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "drivePortfolioSync"
  }
}