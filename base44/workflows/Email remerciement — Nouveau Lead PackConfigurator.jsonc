{
  "name": "Email remerciement \u2014 Nouveau Lead PackConfigurator",
  "description": "Envoie un email de remerciement personnalis\u00e9 avec le r\u00e9capitulatif du pack d\u00e8s qu'un lead est cr\u00e9\u00e9 via le PackConfigurator (source = formulaire).",
  "trigger": {
    "condition": "${ ((.trigger.data.source == \"formulaire\") and (.trigger.data.email != null and .trigger.data.email != \"\" and .trigger.data.email != [] and .trigger.data.email != {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Lead"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "email_remerciement_nouveau_lead_packconfigurator",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendPackThankYouEmail",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendPackThankYouEmail"
  }
}