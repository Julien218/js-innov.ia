{
  "name": "Customer",
  "type": "object",
  "properties": {
    "prenom": {
      "type": "string",
      "description": "Pr\u00e9nom du client"
    },
    "nom": {
      "type": "string",
      "description": "Nom du client"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email du client"
    },
    "telephone": {
      "type": "string",
      "description": "T\u00e9l\u00e9phone du client"
    },
    "entreprise": {
      "type": "string",
      "description": "Nom de l'entreprise"
    },
    "secteur_activite": {
      "type": "string",
      "description": "Secteur d'activit\u00e9"
    }
  },
  "required": [
    "prenom",
    "nom",
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}