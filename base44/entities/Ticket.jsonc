{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "basse",
        "normale",
        "urgente"
      ],
      "default": "normale"
    },
    "status": {
      "type": "string",
      "enum": [
        "ouvert",
        "en analyse",
        "en cours",
        "r\u00e9solu"
      ],
      "default": "ouvert"
    },
    "client_email": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "client_email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}