{
  "name": "Automation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de l'automatisation"
    },
    "description": {
      "type": "string",
      "description": "Description d\u00e9taill\u00e9e"
    },
    "category": {
      "type": "string",
      "enum": [
        "Marketing",
        "Productivit\u00e9",
        "E-commerce",
        "Service Client",
        "Gestion de donn\u00e9es",
        "Autre"
      ],
      "default": "Productivit\u00e9"
    },
    "price": {
      "type": "number",
      "description": "Prix en euros"
    },
    "setup_time": {
      "type": "string",
      "description": "Temps de mise en place (ex: 24h)"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Avantages cl\u00e9s"
    },
    "icon": {
      "type": "string",
      "description": "Nom de l'ic\u00f4ne"
    },
    "popular": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "description"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    }
  }
}