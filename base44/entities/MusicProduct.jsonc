{
  "name": "MusicProduct",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de la bande sonore"
    },
    "description": {
      "type": "string",
      "description": "Description d\u00e9taill\u00e9e"
    },
    "style": {
      "type": "string",
      "enum": [
        "Lounge",
        "Jazz",
        "Pop",
        "\u00c9lectronique",
        "Classique",
        "Ambiance",
        "\u00c9nergique",
        "Relaxante"
      ],
      "default": "Ambiance"
    },
    "duration": {
      "type": "string",
      "description": "Dur\u00e9e (ex: 3:45)"
    },
    "bpm": {
      "type": "number",
      "description": "Tempo en BPM"
    },
    "preview_url": {
      "type": "string",
      "description": "URL audio preview (30 sec)"
    },
    "cover_image": {
      "type": "string",
      "description": "Image de couverture"
    },
    "price": {
      "type": "number",
      "description": "Prix en euros"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "ID du prix Stripe"
    },
    "license_type": {
      "type": "string",
      "enum": [
        "Licence Boutique",
        "Licence Restaurant",
        "Licence Multi-sites",
        "Licence Premium"
      ],
      "default": "Licence Boutique",
      "description": "Type de licence commerciale"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Avantages inclus (libre de droits SABAM, usage illimit\u00e9, etc.)"
    },
    "ideal_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Id\u00e9al pour (boutique de v\u00eatements, restaurant, spa, etc.)"
    },
    "popular": {
      "type": "boolean",
      "default": false,
      "description": "Mise en avant"
    }
  },
  "required": [
    "title",
    "description",
    "style",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}