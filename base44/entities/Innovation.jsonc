      "type": "string",
      "description": "Titre de l'innovation"
    },
    "description": {
      "type": "string",
      "description": "Description courte"
    },
    "content": {
      "type": "string",
      "description": "Contenu complet de l'article"
    },
    "category": {
      "type": "string",
      "enum": [
        "IA G\u00e9n\u00e9rative",
        "Automatisation",
        "Vision par ordinateur",
        "NLP",
        "Robotique",
        "Autre"
