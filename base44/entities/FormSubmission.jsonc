{
  "name": "FormSubmission",
  "type": "object",
  "properties": {
    "form_id": {
      "type": "string",
      "description": "ID du formulaire"
    },
    "form_name": {
      "type": "string",
      "description": "Nom du formulaire"
    },
    "data": {
      "type": "object",
      "description": "Donn\u00e9es soumises"
    },
    "status": {
      "type": "string",
      "enum": [
        "Nouveau",
        "En cours",
        "Trait\u00e9",
        "Ferm\u00e9"
      ],
      "default": "Nouveau",
      "description": "Statut de la soumission"
    },
    "notes": {
      "type": "string",
      "description": "Notes internes"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email de l'utilisateur assign\u00e9"
    }
  },
  "required": [
    "form_id",
    "data"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}