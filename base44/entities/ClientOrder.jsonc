{
  "name": "ClientOrder",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "pack": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "en_attente",
        "acompte_pay\u00e9",
        "en_production",
        "livr\u00e9"
      ],
      "default": "en_attente"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "stripe_session_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_email",
    "pack"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}