{
  "name": "CustomForm",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du formulaire"
    },
    "description": {
      "type": "string",
      "description": "Description du formulaire"
    },
    "slug": {
      "type": "string",
      "description": "URL unique du formulaire"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Configuration des champs du formulaire"
    },
    "branding": {
      "type": "object",
      "description": "Identit\u00e9 visuelle (couleurs, logo, etc.)"
    },
    "notification_email": {
      "type": "string",
      "description": "Email pour recevoir les notifications"
    },
    "success_message": {
      "type": "string",
      "description": "Message de confirmation"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Formulaire actif"
    }
  },
  "required": [
    "name",
    "slug",
    "fields"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}