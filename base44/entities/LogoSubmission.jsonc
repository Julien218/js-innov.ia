{
  "name": "LogoSubmission",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Habitant de Dour",
        "Commer\u00e7ant \u00e0 Dour",
        "Les deux"
      ],
      "description": "Type de participant"
    },
    "quartier": {
      "type": "string",
      "description": "Quartier ou village"
    },
    "valeurs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Valeurs \u00e0 repr\u00e9senter (max 4)"
    },
    "valeur_autre": {
      "type": "string",
      "description": "Autre valeur non list\u00e9e"
    },
    "image_dour": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Image de Dour"
    },
    "style": {
      "type": "string",
      "enum": [
        "Moderne & simple",
        "Chaleureux & humain",
        "Associatif & citoyen",
        "Institutionnel",
        "Cr\u00e9atif / original"
      ],
      "description": "Style souhait\u00e9 du logo"
    },
    "couleurs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Couleurs pr\u00e9f\u00e9r\u00e9es"
    },
    "couleur_autre": {
      "type": "string",
      "description": "Autre couleur"
    },
    "slogan_souhaite": {
      "type": "string",
      "enum": [
        "Oui",
        "Non",
        "Je ne sais pas"
      ],
      "description": "Souhait de slogan"
    },
    "suggestion_slogan": {
      "type": "string",
      "description": "Suggestion de slogan"
    },
    "message_libre": {
      "type": "string",
      "description": "Mot, id\u00e9e ou symbole"
    }
  },
  "required": [
    "type",
    "valeurs",
    "image_dour",
    "style",
    "couleurs",
    "slogan_souhaite"
  ]
}