{
  "name": "Template",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du template"
    },
    "description": {
      "type": "string",
      "description": "Description du template"
    },
    "category": {
      "type": "string",
      "enum": [
        "Vid\u00e9o Marketing",
        "R\u00e9seaux Sociaux",
        "Pr\u00e9sentation",
        "Animation 3D",
        "Motion Design",
        "Autre"
      ],
      "default": "Vid\u00e9o Marketing"
    },
    "preview_url": {
      "type": "string",
      "description": "URL de preview vid\u00e9o/image"
    },
    "price": {
      "type": "number",
      "description": "Prix en euros"
    },
    "duration": {
      "type": "string",
      "description": "Dur\u00e9e estim\u00e9e (ex: 30 sec)"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fonctionnalit\u00e9s incluses"
    }
  },
  "required": [
    "name",
    "description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}