{
  "name": "SaasContent",
  "type": "object",
  "properties": {
    "clientName": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Facebook",
        "Instagram",
        "LinkedIn",
        "YouTube",
        "TikTok",
        "Blog",
        "Email",
        "Autre"
      ]
    },
    "contentType": {
      "type": "string",
      "enum": [
        "post",
        "story",
        "vid\u00e9o",
        "script",
        "article",
        "email",
        "visuel",
        "autre"
      ]
    },
    "text": {
      "type": "string"
    },
    "mediaUrl": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "brouillon",
        "\u00e0 valider",
        "valid\u00e9",
        "publi\u00e9",
        "refus\u00e9"
      ],
      "default": "brouillon"
    },
    "scheduledDate": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "platform",
    "contentType"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}