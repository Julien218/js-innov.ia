{
  "name": "DynamicPage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de la page"
    },
    "slug": {
      "type": "string",
      "description": "URL de la page (ex: about, services, equipe)"
    },
    "content": {
      "type": "string",
      "description": "Contenu HTML/Markdown de la page"
    },
    "meta_description": {
      "type": "string",
      "description": "Description SEO"
    },
    "show_in_nav": {
      "type": "boolean",
      "default": false,
      "description": "Afficher dans la navigation"
    },
    "nav_label": {
      "type": "string",
      "description": "Label dans la navigation"
    },
    "status": {
      "type": "string",
      "enum": [
        "publi\u00e9e",
        "brouillon"
      ],
      "default": "brouillon",
      "description": "Statut de la page"
    },
    "cover_image": {
      "type": "string",
      "description": "Image de couverture"
    }
  },
  "required": [
    "title",
    "slug",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}