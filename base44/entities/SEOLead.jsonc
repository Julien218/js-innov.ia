{
  "name": "SEOLead",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email du prospect"
    },
    "website_url": {
      "type": "string",
      "description": "URL du site analys\u00e9"
    },
    "global_score": {
      "type": "number",
      "description": "Score SEO global"
    },
    "audit_data": {
      "type": "object",
      "description": "Donn\u00e9es compl\u00e8tes de l'audit"
    },
    "status": {
      "type": "string",
      "enum": [
        "nouveau",
        "contact\u00e9",
        "en discussion",
        "client",
        "perdu"
      ],
      "default": "nouveau"
    },
    "notes": {
      "type": "string",
      "description": "Notes internes"
    }
  },
  "required": [
    "email",
    "website_url"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}