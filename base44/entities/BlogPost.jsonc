{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de l'article"
    },
    "slug": {
      "type": "string",
      "description": "URL unique de l'article"
    },
    "excerpt": {
      "type": "string",
      "description": "R\u00e9sum\u00e9 court (150-160 caract\u00e8res)"
    },
    "content": {
      "type": "string",
      "description": "Contenu complet en markdown"
    },
    "category": {
      "type": "string",
      "enum": [
        "Intelligence Artificielle",
        "Automatisation",
        "SEO Local",
        "Cas Pratiques",
        "Tutoriels",
        "Actualit\u00e9s"
      ],
      "default": "Intelligence Artificielle"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags et mots-cl\u00e9s SEO"
    },
    "cover_image": {
      "type": "string",
      "description": "Image de couverture"
    },
    "seo_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mots-cl\u00e9s SEO principaux"
    },
    "seo_score": {
      "type": "number",
      "description": "Score SEO de l'article (0-100)"
    },
    "reading_time": {
      "type": "number",
      "description": "Temps de lecture en minutes"
    },
    "status": {
      "type": "string",
      "enum": [
        "brouillon",
        "publi\u00e9",
        "planifi\u00e9"
      ],
      "default": "brouillon"
    },
    "published_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de publication"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false,
      "description": "Article g\u00e9n\u00e9r\u00e9 par IA"
    }
  },
  "required": [
    "title",
    "slug",
    "content",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}