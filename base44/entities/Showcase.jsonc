{
  "name": "Showcase",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre du projet"
    },
    "description": {
      "type": "string",
      "description": "Description d\u00e9taill\u00e9e"
    },
    "client": {
      "type": "string",
      "description": "Nom du client"
    },
    "category": {
      "type": "string",
      "enum": [
        "Cr\u00e9ation artistique",
        "Automatisation",
        "Application IA",
        "Template vid\u00e9o",
        "Analyse de donn\u00e9es",
        "Chatbot",
        "Vision par ordinateur",
        "Autre"
      ],
      "default": "Autre"
    },
    "ai_techniques": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Techniques IA utilis\u00e9es (GPT, DALL-E, Stable Diffusion, etc.)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags du projet"
    },
    "image_url": {
      "type": "string",
      "description": "Image principale du projet"
    },
    "gallery_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Galerie d'images"
    },
    "demo_url": {
      "type": "string",
      "description": "Lien vers d\u00e9mo/projet"
    },
    "results": {
      "type": "string",
      "description": "R\u00e9sultats obtenus"
    },
    "duration": {
      "type": "string",
      "description": "Dur\u00e9e du projet"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Projet mis en avant"
    }
  },
  "required": [
    "title",
    "description",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}