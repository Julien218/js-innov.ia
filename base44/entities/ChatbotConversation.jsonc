{
  "name": "ChatbotConversation",
  "type": "object",
  "properties": {
    "leadId": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "recommendedPack": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "en cours",
        "termin\u00e9",
        "converti"
      ],
      "default": "en cours"
    },
    "leadData": {
      "type": "object"
    },
    "consentGiven": {
      "type": "boolean",
      "default": false
    }
  },
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}