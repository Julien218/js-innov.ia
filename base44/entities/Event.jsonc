{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "capacity": {
      "type": "number"
    },
    "tickets_sold": {
      "type": "number",
      "default": 0
    },
    "cover_image": {
      "type": "string"
    },
    "organizer_email": {
      "type": "string"
    },
    "organizer_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "closed"
      ],
      "default": "draft"
    },
    "qr_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "date"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}