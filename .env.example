# JS-Innov.IA — Connexion Cockpit
# Option 1 — webhook Make / n8n / Railway
VITE_COCKPIT_WEBHOOK_URL=

# Option 2 — API cockpit local / Railway
VITE_COCKPIT_API_URL=http://127.0.0.1:8787
VITE_COCKPIT_API_KEY=

# ── Commerce Digital Signage / Stripe ─────────────────────────
# Toutes les valeurs ci-dessous sont SERVEUR uniquement. Ne jamais les préfixer par VITE_.
SITE_URL=https://jsinnovia.com
COCKPIT_COMMERCE_URL=https://cockpit.jsinnovia.com/api/commerce
COMMERCE_BRIDGE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SIGNAGE_MONTHLY=
STRIPE_PRICE_SIGNAGE_SETUP=
STRIPE_PRICE_SIGNAGE_SURVEILLANCE_MONTHLY=
STRIPE_PRICE_SIGNAGE_SURVEILLANCE_SETUP=
# Fallback facultatif si le même prix d'installation est utilisé pour les deux offres
STRIPE_PRICE_INSTALLATION=

# ── Pixelium / Espace C — demandes de devis ───────────────────
# Le navigateur n'accède jamais directement au cockpit ni aux secrets.
# Cette page est attribuée à Julien P. par défaut. Changer cette variable uniquement
# lors de la création d'une page commerciale distincte.
PIXELIUM_PAGE_COMMERCIAL_CODE=JP
PIXELIUM_QUOTE_API_URL=https://olivier-signage-cockpit-production.up.railway.app/api/pixelium

# Important : ne mets jamais une clé secrète sensible directement dans le front public.
# Utilise uniquement le backend server.cjs / server-pixelium.cjs pour les passerelles serveur.
